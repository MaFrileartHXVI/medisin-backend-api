	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login - Success (Encrypted Payload)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Enkripsi username dan password menggunakan CryptoJS AES-256-CBC",
									"const key = pm.collectionVariables.get('crypto_key') || 'SintasiSecurePayloadKey2026#X9!';",
									"const rawUser = 'admin';",
									"const rawPass = 'password123';",
									"",
									"const encUser = CryptoJS.AES.encrypt(rawUser, key).toString();",
									"const encPass = CryptoJS.AES.encrypt(rawPass, key).toString();",
									"",
									"pm.collectionVariables.set('enc_username', encUser);",
									"pm.collectionVariables.set('enc_password', encPass);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Login returns token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.token).to.be.a('string');",
									"    pm.collectionVariables.set('auth_token', jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{enc_username}}\",\n    \"password\": \"{{enc_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
