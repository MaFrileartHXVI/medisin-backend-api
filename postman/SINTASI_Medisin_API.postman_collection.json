									"const encUser = CryptoJS.AES.encrypt('admin', key).toString();",
									"const encPass = CryptoJS.AES.encrypt('wrong_password_xyz', key).toString();",
									"pm.collectionVariables.set('enc_wrong_user', encUser);",
									"pm.collectionVariables.set('enc_wrong_pass', encPass);"
								],
								"type": "text/javascript"
							}
